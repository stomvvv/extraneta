# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=extraneta
POSTGRES_USER=extraneta
POSTGRES_PASSWORD=changeme

DATABASE_URL=postgresql+asyncpg://extraneta:changeme@db:5432/extraneta

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MinIO (S3-compatible storage) ─────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=extraneta-uploads
MINIO_SECURE=false

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=supersecretkey-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:80"]
FRONTEND_URL=http://localhost:3000

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@extraneta.ru
EMAILS_FROM_NAME=ExtranEta
